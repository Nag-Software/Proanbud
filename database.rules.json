{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $userId",
        "tilbud": {
          "$tilbudId": {
            ".read": "auth != null || (data.child('viewToken').exists() && query.orderByKey == null)"
          }
        }
      }
    }
  }
}
