{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId",
        
        "profile": {
          ".validate": "newData.hasChildren(['navn', 'epost'])"
        },
        
        "userSettings": {
          ".validate": "newData.hasChildren()"
        },
        
        "businessSettings": {
          ".validate": "newData.hasChildren(['companyName', 'email', 'phone'])"
        },
        
        "tilbud": {
          "$tilbudId": {
            ".validate": "newData.hasChildren(['kundenavn', 'prosjekt', 'jobbtype', 'belop', 'status', 'dato', 'svarfrist']) && newData.child('belop').isNumber() && newData.child('status').val().matches(/^(venter|vunnet|tapt)$/) && newData.child('dato').isString() && newData.child('svarfrist').isString()",
            "prisgrunnlag": {
              "$componentId": {
                ".validate": "newData.hasChildren(['category', 'name', 'amount']) && newData.child('amount').isNumber() && newData.child('category').val().matches(/^(materialer|arbeid|transport|utstyr|margin|annet)$/)"
              }
            }
          }
        },
        
        "kunder": {
          "$kundeId": {
            ".validate": "newData.hasChildren(['navn', 'epost', 'telefon', 'antallTilbud', 'antallVunnet', 'sistAktivitet']) && newData.child('antallTilbud').isNumber() && newData.child('antallVunnet').isNumber() && newData.child('epost').isString().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)",
            "addresser": {
              ".validate": "newData.isString()"
            },
            "tilbud": {
              "$tilbudId": {
                ".validate": "root.child('users').child($userId).child('tilbud').child($tilbudId).exists()"
              }
            }
          }
        },
        
        "inbox": {
          "$messageId": {
            ".validate": "newData.hasChildren(['from', 'subject', 'message', 'timestamp', 'isRead', 'type']) && newData.child('isRead').isBoolean() && newData.child('timestamp').isNumber() && newData.child('type').val().matches(/^(quote_sent|quote_opened|quote_question|quote_approved|quote_rejected|general_inquiry)$/)"
          }
        },
        
        "analytics": {
          ".validate": "newData.hasChildren()",
          "kpiData": {
            ".validate": "newData.hasChildren()"
          },
          "chartData": {
            ".validate": "newData.hasChildren()"
          },
          "activities": {
            "$activityId": {
              ".validate": "newData.hasChildren(['type', 'title', 'description', 'timestamp']) && newData.child('type').val().matches(/^(tilbud_sendt|tilbud_vunnet|tilbud_tapt|ny_kunde)$/)"
            }
          },
          "jobbtypeAnalyse": {
            "$jobbtype": {
              ".validate": "newData.hasChildren(['jobbtype', 'treffprosent', 'antallTilbud', 'antallVunnet']) && newData.child('treffprosent').isNumber() && newData.child('antallTilbud').isNumber() && newData.child('antallVunnet').isNumber()"
            }
          },
          "inntektFordeling": {
            "$jobbtype": {
              ".validate": "newData.hasChildren(['jobbtype', 'inntekt', 'prosent']) && newData.child('inntekt').isNumber() && newData.child('prosent').isNumber()"
            }
          }
        },
        
        "subscription": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": false,
          ".validate": "newData.hasChildren(['plan', 'status', 'updatedAt']) && newData.child('plan').val().matches(/^(free|basic|pro)$/) && newData.child('status').val().matches(/^(active|canceled|past_due|incomplete|trialing|incomplete_expired|unpaid)$/) && newData.child('updatedAt').isNumber()",
          
          "stripeCustomerId": {
            ".validate": "newData.isString()"
          },
          "stripeSubscriptionId": {
            ".validate": "newData.isString()"
          },
          "stripePriceId": {
            ".validate": "newData.isString()"
          },
          "currentPeriodStart": {
            ".validate": "newData.isNumber()"
          },
          "currentPeriodEnd": {
            ".validate": "newData.isNumber()"
          },
          "cancelAtPeriodEnd": {
            ".validate": "newData.isBoolean()"
          },
          "canceledAt": {
            ".validate": "newData.isNumber()"
          },
          "trialStart": {
            ".validate": "newData.isNumber()"
          },
          "trialEnd": {
            ".validate": "newData.isNumber()"
          }
        },
        
        "invoices": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": false,
          "$invoiceId": {
            ".validate": "newData.hasChildren(['amount', 'currency', 'status', 'createdAt']) && newData.child('amount').isNumber() && newData.child('createdAt').isNumber()"
          }
        }
      }
    },
    
    "katalog": {
      ".read": "auth != null",
      ".write": "auth != null",
      
      "$categoryId": {
        ".validate": "(newData.hasChildren(['navn', 'opprettet', 'oppdatert']) && !newData.hasChild('kategoriId') && !newData.hasChild('produktnavn')) || (newData.hasChildren(['navn', 'kategoriId', 'opprettet', 'oppdatert']) && !newData.hasChild('produktnavn')) || (newData.hasChildren(['produktnavn', 'produsent', 'enhet', 'enhetspris', 'påslag', 'kategoriId', 'underkategoriId', 'opprettet', 'oppdatert']) && newData.child('enhetspris').isNumber() && newData.child('påslag').isNumber())",
        
        "$itemId": {
          ".validate": "(newData.hasChildren(['navn', 'kategoriId', 'opprettet', 'oppdatert']) && !newData.hasChild('produktnavn')) || (newData.hasChildren(['produktnavn', 'produsent', 'enhet', 'enhetspris', 'påslag', 'kategoriId', 'underkategoriId', 'opprettet', 'oppdatert']) && newData.child('enhetspris').isNumber() && newData.child('påslag').isNumber())"
        }
      }
    }
  }
}
