# Sanity CMS miljøvariabler
# Opprett et prosjekt på https://www.sanity.io/manage
# Deretter fyll inn disse verdiene:

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# For Sanity Studio (kun nødvendig for /studio route)
SANITY_API_READ_TOKEN=your_read_token_here
SANITY_API_WRITE_TOKEN=your_write_token_here

# For preview mode (valgfritt)
SANITY_PREVIEW_SECRET=your_random_secret_here
